# Stellar testnet
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# Deployer (funded testnet secret). Used by deploy + demo:payout. Never commit this file.
DEPLOYER_SECRET=

# Fallback if stellar.toml cannot be read. Deploy reads the live anchor asset.
USDC_ASSET_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Only mint when the deployer is the asset issuer (not used for testanchor SRT/USDC).
E2E_MINT_USDC=false

# Written by `npm run deploy:testnet` to config/testnet.json as well
REPUTATION_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
ESCROW_CONTRACT_ID=
USDC_CONTRACT_ID=

# Invisible-wallet encryption: 32-byte key as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# API
PORT=3001
SESSION_SECRET=change-me
ADMIN_USER_EMAIL=admin@zao.local

# Anchor — swap to Paychant / Yellow Card by changing this URL
ANCHOR_HOME_DOMAIN=https://testanchor.stellar.org
# Must match a [[CURRENCIES]] code in the anchor stellar.toml. testanchor issues SRT.
ANCHOR_ASSET_CODE=SRT

# KYC/AML gate (Deliverable 3). Human units of the pool asset.
AML_MAX_AMOUNT=1000
# Comma-separated G... public keys to block at disburse.
AML_DENYLIST=

# Supabase (hosted Postgres). Unit tests still use local SQLite.
# Project Settings → Database → URI. Never commit the password.
SUPABASE_URL=https://ktqukwdgsfjdhvenydmd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
